<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AAOS (Android Automotive OS). Il flavor play non include questa dichiarazione:
         su Google Play i media app sono ammessi solo nel track "AAOS only"
         (android:required true o assente), non nel track mobile. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <application>
        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/auto_app_desc" />
    </application>

</manifest>
